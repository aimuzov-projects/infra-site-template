---
// Яндекс Метрика. Сайт без счётчика: удалить этот компонент, его вызов в Base.astro
// и источники mc.yandex.ru и yastatic.net из security.csp в astro.config.mjs.
---

{/* Скрипт счётчика (~85 КБ) на мобильном отнимает канал у шрифтов и первого фото, поэтому
    грузим его по первому действию или через 4 с после load, вызовы ym до того ждут в очереди.
    Вебвизор выключен: на мобильном он заметно поднимает LCP. Комментарии здесь, а не в скрипте:
    is:inline уходит в HTML как есть. */}
<script is:inline>
	;(function (m, e, t, r, i, k, a) {
		m[i] =
			m[i] ||
			function () {
				;(m[i].a = m[i].a || []).push(arguments)
			}
		m[i].l = 1 * new Date()
		for (var j = 0; j < document.scripts.length; j++) {
			if (document.scripts[j].src === r) {
				return
			}
		}
		var events = ['scroll', 'pointerdown', 'keydown', 'touchstart']
		var load = function () {
			if (k) return
			events.forEach(function (name) {
				m.removeEventListener(name, load)
			})
			k = e.createElement(t)
			a = e.getElementsByTagName(t)[0]
			k.async = 1
			k.src = r
			a.parentNode.insertBefore(k, a)
		}
		events.forEach(function (name) {
			m.addEventListener(name, load, { passive: true })
		})
		var later = function () {
			setTimeout(load, 4000)
		}
		if (e.readyState === 'complete') later()
		else m.addEventListener('load', later)
	})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=__METRIKA_ID__', 'ym')

	ym(__METRIKA_ID__, 'init', {
		ssr: true,
		webvisor: false,
		clickmap: true,
		ecommerce: 'dataLayer',
		referrer: document.referrer,
		url: location.href,
		accurateTrackBounce: true,
		trackLinks: true,
	})
</script>
<noscript>
	<div>
		<img src="https://mc.yandex.ru/watch/__METRIKA_ID__" style="position:absolute; left:-9999px;" alt="" />
	</div>
</noscript>
